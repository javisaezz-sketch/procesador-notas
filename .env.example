# Ejemplo — copia a .env en local (no subas .env a GitHub)

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Solo en Vercel (protege el panel en Internet)
DASHBOARD_USER=panel
DASHBOARD_PASSWORD=

# URL pública del panel (Vercel). Opcional en local; GitHub Actions la usa en el pipeline.
DASHBOARD_URL=https://panel-editorial.vercel.app
