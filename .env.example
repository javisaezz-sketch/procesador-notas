# Ejemplo — copia a .env en local (no subas .env a GitHub)

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# WordPress (application password, compartida por los 4 medios si aplica)
WP_API_USER=
WP_API_PASSWORD=
# Opcional: contraseña POP3 común de panel@*
# EMAIL_POP_PASSWORD=
# Solo para scripts/seguridad-rls (Settings → Database en Supabase)
# SUPABASE_DB_PASSWORD=
# DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Solo en Vercel (protege el panel en Internet)
DASHBOARD_USER=panel
DASHBOARD_PASSWORD=

# URL pública del panel (Vercel). Opcional en local; GitHub Actions la usa en el pipeline.
DASHBOARD_URL=https://panel-editorial.vercel.app
